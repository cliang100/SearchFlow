# Used when running uvicorn directly. Docker Compose sets its own values.
DATABASE_URL=postgresql://searchflow:password@localhost:5433/searchflow
REDIS_URL=redis://localhost:6379

# Enables crawling and document changes. Leave empty for a read-only server.
ADMIN_TOKEN=

# Comma-separated origins allowed to call the API from a browser on another site
CORS_ORIGINS=

# Seconds between page fetches during a crawl
CRAWL_DELAY=1.0

# Local development only: allow crawling localhost and private networks
ALLOW_PRIVATE_CRAWL=false
